@{
    ViewData["Title"] = "Home";
}

<h1 class="h3 mb-1">JobDesk</h1>
<p class="text-muted mb-4">Work orders and customers. Quick reports.</p>

@if (!string.IsNullOrWhiteSpace(DemoMode.PreparedFor))
{
    <div class="card border-primary-subtle mb-4">
        <div class="card-body small">
            <div class="fw-semibold mb-1">Prepared for @DemoMode.PreparedFor</div>
            <p class="mb-0 text-muted">
                This sample app uses invented field-service data. It is not connected to any employer’s systems.
            </p>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <a class="card text-decoration-none h-100" asp-controller="Customers" asp-action="Index">
            <div class="card-body">
                <div class="text-muted small">Customers</div>
                <div class="display-6">@ViewBag.CustomerCount</div>
            </div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="card text-decoration-none h-100" asp-controller="WorkOrders" asp-action="Index" asp-route-status="Open">
            <div class="card-body">
                <div class="text-muted small">Open work orders</div>
                <div class="display-6">@ViewBag.OpenCount <span class="fs-6 text-muted">of @ViewBag.TotalCount</span></div>
            </div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="card text-decoration-none h-100" asp-controller="Reports" asp-action="Index">
            <div class="card-body">
                <div class="text-muted small">Reports</div>
                <div class="fs-5 mt-2">Open jobs / material cost &rarr;</div>
            </div>
        </a>
    </div>
</div>

<ul class="list-unstyled mb-0">
    <li class="mb-2"><a asp-controller="Ask" asp-action="Index">Ask</a> <span class="text-muted small">— short Q&amp;A from the job list (optional Amazon Bedrock in the hosted demo)</span></li>
    <li class="mb-2"><a asp-controller="Reports" asp-action="Index">Reports</a> <span class="text-muted small">— open jobs by customer</span></li>
    <li class="mb-2"><a asp-controller="Learn" asp-action="Normalization">Normalization notes</a> <span class="text-muted small">— 1NF/2NF/3NF from this data</span></li>
    <li class="mb-2"><a asp-controller="WorkOrders" asp-action="Details" asp-route-id="1">Work order #1</a> <span class="text-muted small">— materials + file uploads</span></li>
</ul>
