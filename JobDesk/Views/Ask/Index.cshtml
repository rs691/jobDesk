@using JobDesk.Services.Databricks
@{
    ViewData["Title"] = "Ask";
    var q = (string)(ViewBag.Question ?? "");
    var answer = (string?)ViewBag.Answer;
    var source = (string?)ViewBag.Source;
    var modelId = (string?)ViewBag.ModelId;
    var examples = AskIntentResolver.ExampleTitles();
}

<h1 class="h3 mb-1">Ask JobDesk</h1>
<p class="text-muted mb-3">
    Short answers from allowlisted read-only queries. When a Databricks token and catalog are configured on the server,
    questions below use the synthetic <code>jobdesk_synthetic</code> warehouse (as-of 2026-11-06). Otherwise answers use the small local SQLite demo.
</p>

<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group">
        <input type="text" name="q" value="@q" class="form-control" maxlength="500"
               placeholder="e.g. Work orders by status" aria-label="Question" autofocus />
        <button class="btn btn-dark" type="submit">Ask</button>
    </div>
</form>

<ul class="small text-muted mb-3">
    <li class="mb-1">Synthetic warehouse (allowlisted titles):</li>
    @foreach (var title in examples)
    {
        <li><a href="?q=@Uri.EscapeDataString(title)">@title</a></li>
    }
</ul>

<div class="small text-muted mb-3">
    Local demo only:
    <a href="?q=open%20jobs%20by%20customer">open jobs by customer</a> ·
    <a href="?q=what%27s%20next%20on%20the%20schedule">what’s next on the schedule</a>
</div>

@if (!string.IsNullOrWhiteSpace(answer))
{
    <div class="card">
        <div class="card-body">
            <pre class="mb-0" style="white-space:pre-wrap;font-family:system-ui,sans-serif">@answer</pre>
        </div>
        <div class="card-footer small text-muted">
            source: @source@(string.IsNullOrEmpty(modelId) ? "" : $" · {modelId}")
        </div>
    </div>
}
