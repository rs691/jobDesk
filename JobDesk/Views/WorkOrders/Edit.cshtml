@model WorkOrder
@{
    ViewData["Title"] = "Edit work order";
}

<h1 class="h3 mb-3">Edit work order #@Model.Id</h1>
<form asp-action="Edit" method="post" class="bg-white border rounded p-3" style="max-width: 720px">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
