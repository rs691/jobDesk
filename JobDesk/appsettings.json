{
  "Demo": {
    "ReadOnly": false,
    "PreparedFor": ""
  },
  "Hosting": {
    "DetailedErrors": false,
    "HttpsRedirection": true,
    "ForwardedHeaders": false
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "JobDesk": "Data Source=jobdesk.db"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "App_Data/uploads"
  },
  "AWS": {
    "Region": "us-east-1",
    "BucketName": "",
    "KeyPrefix": "jobdesk/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ask": {
    "UseBedrock": false,
    "ModelId": "amazon.nova-micro-v1:0",
    "Region": "us-east-1"
  }
}
