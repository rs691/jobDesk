{
  "Demo": {
    "ReadOnly": true,
    "PreparedFor": ""
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "JobDesk": "Data Source=/tmp/jobdesk-demo.db"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "/tmp/jobdesk-uploads"
  },
  "Hosting": {
    "DetailedErrors": false,
    "HttpsRedirection": false,
    "ForwardedHeaders": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Ask": {
    "UseBedrock": true,
    "ModelId": "amazon.nova-micro-v1:0",
    "Region": "us-east-1"
  }
}
